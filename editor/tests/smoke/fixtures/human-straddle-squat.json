    "js": "const object=v.scene.getObjectByName('swap'),clips=object.__reactorClips;for(const name of ['Straddle','Upright Straddle','Squat'])if(!clips.some(c=>c.name===name))throw Error('Missing saved '+name);const clip=clips.find(c=>c.name==='Squat'),mixer=new THREE.AnimationMixer(object);mixer.clipAction(clip).play();mixer.setTime(2);object.updateMatrixWorld(true);return {target:[0,.5,0],clips:clips.filter(c=>/Straddle|Squat/.test(c.name)).map(c=>c.name),duration:clip.duration};"
